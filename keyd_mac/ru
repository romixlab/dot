# Russian layout switching for keyd. Included by mac.conf and ergodox.conf.
# The layout itself is XKB (Hyprland kb_layout = us,ru): keyd only tracks the mode in the
# `ru` layer and tells XKB which group to use (kb_options grp:lctrl_lwin_rctrl_menu):
#   Ctrl+LeftWin -> first layout (us), Ctrl+Menu -> second layout (ru).
# Alt+Space toggles en <-> ru; Esc in ru switches to en (no Escape sent).

[ru]
esc = togglem(ru, C-leftmeta)
102nd = \
\ = A-\

[alt]
space = togglem(ru, C-compose)

[ru+alt]
space = togglem(ru, C-leftmeta)

[ru+shift]
\ = S-\

# Keep Super+Alt+Space (Omarchy apps menu)
[meta+alt]
space = M-A-space

[ru+meta+alt]
space = M-A-space
