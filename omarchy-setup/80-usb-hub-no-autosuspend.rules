# Keep flaky USB hubs awake. Autosuspended with nothing plugged in, they miss
# new connections: a replugged device stays dead until the whole hub is
# power-cycled.
# Terminus FE1.1 USB 2.0 hub
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1a40", ATTR{idProduct}=="0101", TEST=="power/control", ATTR{power/control}="on"
# Genesys Logic USB 3.2 hub (05e3:0625) and its USB 2 half (05e3:0610)
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="05e3", ATTR{idProduct}=="0625|0610", TEST=="power/control", ATTR{power/control}="on"
