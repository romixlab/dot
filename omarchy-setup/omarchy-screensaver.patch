--- a/omarchy-screensaver
+++ b/omarchy-screensaver
@@ -40,9 +40,19 @@
     --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c\
     --random-effect --no-eol --no-restore-cursor &
 
+  last_cursor=""
   while pgrep -t "${tty#/dev/}" -x ttfx >/dev/null; do
-    if read -n1 -t 1 || ! screensaver_in_focus; then
+    # -s keeps a stray keypress from echoing to the screen before we exit.
+    if read -n1 -t 0.3 -s || ! screensaver_in_focus; then
       exit_screensaver
     fi
+
+    # Terminals don't forward mouse-move events to stdin, so poll the cursor
+    # position instead and treat any change as activity too.
+    cursor=$(hyprctl cursorpos 2>/dev/null)
+    if [[ -n $last_cursor && $cursor != "$last_cursor" ]]; then
+      exit_screensaver
+    fi
+    last_cursor=$cursor
   done
 done
